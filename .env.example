# ThingsBoard Configuration
THINGSBOARD_BASE_URL=https://schnelliot.in
THINGSBOARD_USERNAME=your_username@domain.com
THINGSBOARD_PASSWORD=your_password

# Google Chat Incoming Webhook URL (For Ward 167 & Ward 118 reports)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXXX/messages?key=YYYYYY&token=ZZZZZZ

# Google Chat Incoming Webhook URL (For 4-Zone Telemetry reports - Optional if different)
ZONES_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXXX/messages?key=YYYYYY&token=ZZZZZZ
